{
  "name": "erp",
  "version": "1.5.0",
  "private": true,
  "description": "Construction company ERP front-end built on the Plane API",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3010",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 3010",
    "start": "serve -s dist -l 3010",
    "clean": "rm -rf .turbo dist node_modules",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "recharts": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "postcss": "catalog:",
    "serve": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
